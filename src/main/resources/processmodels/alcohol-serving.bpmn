      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
  <bpmndi:BPMNDiagram id="BPMNDiagram_decision_phase">
    <bpmndi:BPMNPlane id="BPMNPlane_decision_phase" bpmnElement="decision_phase">
      <bpmndi:BPMNShape id="BPMNShape_start_decision_phase" bpmnElement="start_decision_phase">
        <dc:Bounds x="180" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="160" y="225" width="76" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_external_task_check_decision" bpmnElement="external_task_check_decision">
        <dc:Bounds x="270" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_gateway_decision_outcome" bpmnElement="gateway_decision_outcome" isMarkerVisible="true">
        <dc:Bounds x="430" y="175" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="486" y="230" width="84" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_external_task_create_asset" bpmnElement="external_task_create_asset">
        <dc:Bounds x="540" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_end_decision_phase" bpmnElement="end_decision_phase">
        <dc:Bounds x="702" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="684" y="225" width="72" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_gateway_await_decision" bpmnElement="gateway_await_decision">
        <dc:Bounds x="430" y="305" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="486" y="340" width="72" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_await_decision_updated" bpmnElement="await_decision_updated">
        <dc:Bounds x="352" y="312" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="360" y="355" width="82" height="14" />
