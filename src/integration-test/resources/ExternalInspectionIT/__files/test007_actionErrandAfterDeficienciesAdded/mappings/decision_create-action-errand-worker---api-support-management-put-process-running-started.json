{
	"name": "decision_create-action-errand-worker---api-support-management-put-process-running-started",
	"request": {
		"method": "PUT",
		"urlPathPattern": "/api-support-management/2281/ALKT/errands/4f8a1d62-3b07-4e94-a1c5-7d2f6b9e0345/processes/[^/]+",
		"headers": {
			"X-Sent-By": {
				"equalTo": "pw-alkt; type=processEngine"
			}
		},
		"bodyPatterns": [
			{
				"matchesJsonPath": {
					"expression": "$.processStatus",
					"equalTo": "RUNNING"
				}
			},
			{
				"matchesJsonPath": {
					"expression": "$.currentActivityId",
					"equalTo": "external_task_create_action_errand"
				}
			},
			{
				"matchesJsonPath": "$.awaitingSignals[?(@.name == 'process_cancelled')]"
			}
		]
	},
	"response": {
		"headers": {
			"Content-Type": "application/json"
		},
		"body": "{}",
		"status": 200
	}
}
