{
	"name": "registration_process-service---api-support-management-put-process-waiting",
	"metadata": {
		"comment": "A notification a case worker created waits in the registration."
	},
	"request": {
		"method": "PUT",
		"urlPathPattern": "/api-support-management/2281/ALKT/errands/3b7e2c91-5d4a-4e8f-a1c6-9f0d2b8e7a54/processes/[^/]+",
		"headers": {
			"X-Sent-By": {
				"equalTo": "pw-alkt; type=processEngine"
			}
		},
		"bodyPatterns": [
			{
				"matchesJsonPath": {
					"expression": "$.processStatus",
					"equalTo": "WAITING"
				}
			},
			{
				"matchesJsonPath": {
					"expression": "$.processKey",
					"equalTo": "tobacco-free-nicotine-product-sales"
				}
			},
			{
				"matchesJsonPath": {
					"expression": "$.currentActivityId",
					"equalTo": "registration_phase"
				}
			},
			{
				"matchesJsonPath": {
					"expression": "$.currentActivityName",
					"equalTo": "Registration"
				}
			},
			{
				"matchesJsonPath": {
					"expression": "$.awaitingSignals[0].name",
					"equalTo": "registration_completed"
				}
			},
			{
				"matchesJsonPath": {
					"expression": "$.awaitingSignals[0].label",
					"equalTo": "Registration completed"
				}
			},
			{
				"matchesJsonPath": "$.awaitingSignals[?(@.name == 'process_cancelled')]"
			}
		]
	},
	"response": {
		"headers": {
			"Content-Type": "application/json",
			"Content-Encoding": "identity"
		},
		"body": "{}",
		"status": 200
	}
}
