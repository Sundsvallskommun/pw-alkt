{
	"name": "decision_notify-customer-worker---api-support-management-put-process-done",
	"priority": 1,
	"request": {
		"method": "PUT",
		"urlPathPattern": "/api-support-management/2281/ALKT/errands/c30a6f18-9d54-4b72-8e05-2f1a7c4b6d98/processes/[^/]+",
		"headers": {
			"X-Sent-By": {
				"equalTo": "pw-alkt; type=processEngine"
			}
		},
		"bodyPatterns": [
			{
				"matchesJsonPath": {
					"expression": "$.processStatus",
					"equalTo": "RUNNING"
				}
			},
			{
				"matchesJsonPath": {
					"expression": "$.currentActivityId",
					"equalTo": "external_task_notify_notification_registered"
				}
			},
			{
				"matchesJsonPath": "$.activities[?(@.activityId == 'external_task_notify_notification_registered#done' && @.activityName == 'Kunden har fått besked om att anmälan har registrerats')]"
			}
		]
	},
	"response": {
		"headers": {
			"Content-Type": "application/json"
		},
		"body": "{}",
		"status": 200
	}
}
