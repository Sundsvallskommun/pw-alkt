{
	"name": "02_main_cancel-process-worker---api-support-management-put-process-running",
	"request": {
		"method": "PUT",
		"urlPathPattern": "/api-support-management/2281/ALKT/errands/c30a6f18-9d54-4b72-8e05-2f1a7c4b6d98/processes/[^/]+",
		"headers": {
			"X-Sent-By": {
				"equalTo": "pw-alkt; type=processEngine"
			}
		},
		"bodyPatterns": [
			{
				"matchesJsonPath": {
					"expression": "$.processStatus",
					"equalTo": "RUNNING"
				}
			},
			{
				"matchesJsonPath": {
					"expression": "$.currentActivityId",
					"equalTo": "external_task_cancel_process"
				}
			},
			{
				"matchesJsonPath": {
					"expression": "$.awaitingSignals[0]",
					"absent": true
				}
			}
		]
	},
	"response": {
		"headers": {
			"Content-Type": "application/json"
		},
		"body": "{}",
		"status": 200
	}
}
