{
	"name": "decision_assign-restaurant-number-worker---api-support-management-put-process-failed",
	"request": {
		"method": "PUT",
		"urlPathPattern": "/api-support-management/2281/ALKT/errands/3f7d5c21-9a44-4c6e-8b52-1e9f0a2d7c31/processes/[^/]+",
		"headers": {
			"X-Sent-By": {
				"equalTo": "pw-alkt; type=processEngine"
			}
		},
		"bodyPatterns": [
			{
				"matchesJsonPath": {
					"expression": "$.processStatus",
					"equalTo": "FAILED"
				}
			},
			{
				"matchesJsonPath": {
					"expression": "$.activities[0].errorCode",
					"equalTo": "INCIDENT"
				}
			},
			{
				"matchesJsonPath": {
					"expression": "$.activities[0].message",
					"contains": "Restaurant number '22810005' has an assignment that overlaps the one from 2026-10-01. End it in licensed business, then update the errand to try again"
				}
			}
		]
	},
	"response": {
		"headers": {
			"Content-Type": "application/json"
		},
		"body": "{}",
		"status": 200
	}
}
