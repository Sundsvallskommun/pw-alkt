{
	"name": "01_registration_process-service---api-support-management-put-process-waiting",
	"priority": 1,
	"request": {
		"method": "PUT",
		"urlPathPattern": "/api-support-management/2281/ALKT/errands/b7e4c210-58f3-4d96-a1c7-0e9d5f28a3b6/processes/[^/]+",
		"headers": {
			"X-Sent-By": {
				"equalTo": "pw-alkt; type=processEngine"
			}
		},
		"bodyPatterns": [
			{
				"matchesJsonPath": {
					"expression": "$.processStatus",
					"equalTo": "WAITING"
				}
			},
			{
				"matchesJsonPath": {
					"expression": "$.currentActivityId",
					"equalTo": "registration_phase"
				}
			}
		]
	},
	"response": {
		"headers": {
			"Content-Type": "application/json",
			"Content-Encoding": "identity"
		},
		"body": "{}",
		"status": 200
	}
}
