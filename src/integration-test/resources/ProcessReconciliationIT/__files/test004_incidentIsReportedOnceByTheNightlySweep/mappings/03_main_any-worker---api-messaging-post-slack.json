{
	"name": "03_main_any-worker---api-messaging-post-slack",
	"request": {
		"method": "POST",
		"urlPath": "/api-messaging/2281/slack",
		"headers": {
			"X-Sent-By": {
				"equalTo": "pw-alkt; type=processEngine"
			}
		},
		"bodyPatterns": [
			{
				"matchesJsonPath": {
					"expression": "$.token",
					"equalTo": "slack-token"
				}
			},
			{
				"matchesJsonPath": {
					"expression": "$.channel",
					"equalTo": "slack-channel"
				}
			},
			{
				"matchesJsonPath": {
					"expression": "$.message",
					"contains": "[2281][ALKT][low-alcohol-beer-sales] Incident in external_task_create_submission_pdf for errand d4b81f6e-2c93-4a07-8e5d-73a0c9f1b2e8"
				}
			}
		]
	},
	"response": {
		"status": 201
	}
}
