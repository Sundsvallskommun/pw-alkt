{
	"name": "01_follow_up_process-service---api-support-management-put-process-waiting",
	"request": {
		"method": "PUT",
		"urlPathPattern": "/api-support-management/2281/ALKT/errands/1e7d4b90-5c82-4f37-a6e1-9b0c2d8a3f56/processes/[^/]+",
		"headers": {
			"X-Sent-By": {
				"equalTo": "pw-alkt; type=processEngine"
			}
		},
		"bodyPatterns": [
			{
				"matchesJsonPath": {
					"expression": "$.processStatus",
					"equalTo": "WAITING"
				}
			},
			{
				"matchesJsonPath": {
					"expression": "$.processKey",
					"equalTo": "low-alcohol-beer-sales"
				}
			},
			{
				"matchesJsonPath": {
					"expression": "$.currentActivityId",
					"equalTo": "follow_up_phase"
				}
			},
			{
				"matchesJsonPath": {
					"expression": "$.currentActivityName",
					"equalTo": "Follow up"
				}
			},
			{
				"matchesJsonPath": {
					"expression": "$.awaitingSignals[0].name",
					"equalTo": "follow_up_completed"
				}
			},
			{
				"matchesJsonPath": {
					"expression": "$.awaitingSignals[0].label",
					"equalTo": "Follow up completed"
				}
			},
			{
				"matchesJsonPath": "$.awaitingSignals[?(@.name == 'process_cancelled')]"
			}
		]
	},
	"newScenarioState": "follow_up_process-service---api-support-management-put-process-waiting",
	"response": {
		"headers": {
			"Content-Type": "application/json",
			"Content-Encoding": "identity"
		},
		"body": "{}",
		"status": 200
	},
	"scenarioName": "low-alcohol-beer-sales-happy-case"
}
