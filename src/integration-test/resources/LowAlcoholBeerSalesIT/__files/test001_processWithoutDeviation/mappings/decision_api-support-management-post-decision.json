{
	"name": "decision_api-support-management-post-decision",
	"request": {
		"method": "POST",
		"urlPath": "/api-support-management/2281/ALKT/errands/1e7d4b90-5c82-4f37-a6e1-9b0c2d8a3f56/decisions",
		"headers": {
			"X-Sent-By": {
				"equalTo": "pw-alkt; type=processEngine"
			},
			"X-Trigger-Process": {
				"equalTo": "false"
			}
		},
		"bodyPatterns": [
			{
				"matchesJsonPath": {
					"expression": "$.status",
					"equalTo": "DRAFT"
				}
			},
			{
				"matchesJsonPath": {
					"expression": "$.type",
					"equalTo": "PERMIT"
				}
			},
			{
				"matchesJsonPath": {
					"expression": "$.method",
					"equalTo": "AUTOMATIC"
				}
			},
			{
				"matchesJsonPath": {
					"expression": "$.outcome",
					"equalTo": "APPROVAL"
				}
			},
			{
				"matchesJsonPath": {
					"expression": "$.title",
					"equalTo": "Tillstånd för försäljning av folköl"
				}
			},
			{
				"matchesJsonPath": {
					"expression": "$.description",
					"equalTo": "Anmälan om försäljning av folköl"
				}
			},
			{
				"matchesJsonPath": "$.validFrom"
			},
			{
				"matchesJsonPath": "$.decidedAt"
			},
			{
				"matchesJsonPath": {
					"expression": "$.decidedBy",
					"equalTo": "pw-alkt"
				}
			},
			{
				"matchesJsonPath": "$[?(!@.validTo)]"
			}
		]
	},
	"response": {
		"headers": {
			"Location": "http://localhost/2281/ALKT/errands/1e7d4b90-5c82-4f37-a6e1-9b0c2d8a3f56/decisions/4a6c8e02-1b3d-4f57-9a8c-0d2e4f6a8b1c"
		},
		"status": 201
	}
}
