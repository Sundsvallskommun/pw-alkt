{
	"name": "decision_create-decision-worker---api-support-management-put-process-running",
	"request": {
		"method": "PUT",
		"urlPathPattern": "/api-support-management/2281/ALKT/errands/1e7d4b90-5c82-4f37-a6e1-9b0c2d8a3f56/processes/[^/]+",
		"headers": {
			"X-Sent-By": {
				"equalTo": "pw-alkt; type=processEngine"
			}
		},
		"bodyPatterns": [
			{
				"matchesJsonPath": {
					"expression": "$.processStatus",
					"equalTo": "RUNNING"
				}
			},
			{
				"matchesJsonPath": {
					"expression": "$.currentActivityId",
					"equalTo": "external_task_create_decision"
				}
			},
			{
				"matchesJsonPath": {
					"expression": "$.awaitingSignals[0].name",
					"equalTo": "process_cancelled"
				}
			}
		]
	},
	"response": {
		"headers": {
			"Content-Type": "application/json"
		},
		"body": "{}",
		"status": 200
	}
}
