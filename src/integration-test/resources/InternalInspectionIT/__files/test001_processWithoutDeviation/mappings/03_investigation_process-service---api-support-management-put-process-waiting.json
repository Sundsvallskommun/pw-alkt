{
	"name": "03_investigation_process-service---api-support-management-put-process-waiting",
	"request": {
		"method": "PUT",
		"urlPathPattern": "/api-support-management/2281/ALKT/errands/8b5c9e04-7f31-4a68-9d2b-0e6a3c1f54d7/processes/[^/]+",
		"headers": {
			"X-Sent-By": {
				"equalTo": "pw-alkt; type=processEngine"
			}
		},
		"bodyPatterns": [
			{
				"matchesJsonPath": {
					"expression": "$.processStatus",
					"equalTo": "WAITING"
				}
			},
			{
				"matchesJsonPath": {
					"expression": "$.processKey",
					"equalTo": "internal-inspection"
				}
			},
			{
				"matchesJsonPath": {
					"expression": "$.currentActivityId",
					"equalTo": "investigation_phase"
				}
			},
			{
				"matchesJsonPath": {
					"expression": "$.currentActivityName",
					"equalTo": "Investigation"
				}
			},
			{
				"matchesJsonPath": {
					"expression": "$.awaitingSignals[0].name",
					"equalTo": "investigation_completed"
				}
			},
			{
				"matchesJsonPath": {
					"expression": "$.awaitingSignals[0].label",
					"equalTo": "Investigation completed"
				}
			},
			{
				"matchesJsonPath": "$.awaitingSignals[?(@.name == 'process_cancelled')]"
			}
		]
	},
	"newScenarioState": "investigation_process-service---api-support-management-put-process-waiting",
	"requiredScenarioState": "review_process-service---api-support-management-put-process-waiting",
	"response": {
		"headers": {
			"Content-Type": "application/json",
			"Content-Encoding": "identity"
		},
		"body": "{}",
		"status": 200
	},
	"scenarioName": "internal-inspection-happy-case"
}
