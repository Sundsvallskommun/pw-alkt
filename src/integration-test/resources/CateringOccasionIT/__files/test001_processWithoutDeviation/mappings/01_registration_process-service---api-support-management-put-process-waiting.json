					"equalTo": "WAITING"
				}
			},
			{
				"matchesJsonPath": {
					"expression": "$.processKey",
					"equalTo": "catering-occasion"
				}
			},
			{
				"matchesJsonPath": {
					"expression": "$.currentActivityId",
					"equalTo": "registration_phase"
				}
			},
			{
				"matchesJsonPath": {
					"expression": "$.currentActivityName",
					"equalTo": "Registration"
				}
			},
			{
				"matchesJsonPath": {
					"expression": "$.awaitingSignals[0].name",
					"equalTo": "registration_completed"
				}
			},
			{
				"matchesJsonPath": {
					"expression": "$.awaitingSignals[0].label",
					"equalTo": "Registration completed"
				}
			},
			{
				"matchesJsonPath": "$.awaitingSignals[?(@.name == 'process_cancelled')]"
			}
		]
	},
	"newScenarioState": "registration_process-service---api-support-management-put-process-waiting",
	"response": {
		"headers": {
			"Content-Type": "application/json",
