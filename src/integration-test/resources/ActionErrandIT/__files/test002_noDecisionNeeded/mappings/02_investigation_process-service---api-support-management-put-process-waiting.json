{
	"name": "02_investigation_process-service---api-support-management-put-process-waiting",
	"request": {
		"method": "PUT",
		"urlPathPattern": "/api-support-management/2281/ALKT/errands/9d1c3b5a-7e2f-4a6c-8b0d-1e3f5a7c9b2d/processes/[^/]+",
		"headers": {
			"X-Sent-By": {
				"equalTo": "pw-alkt; type=processEngine"
			}
		},
		"bodyPatterns": [
			{
				"matchesJsonPath": {
					"expression": "$.processStatus",
					"equalTo": "WAITING"
				}
			},
			{
				"matchesJsonPath": {
					"expression": "$.processKey",
					"equalTo": "action-errand"
				}
			},
			{
				"matchesJsonPath": {
					"expression": "$.currentActivityId",
					"equalTo": "investigation_phase"
				}
			},
			{
				"matchesJsonPath": {
					"expression": "$.currentActivityName",
					"equalTo": "Investigation"
				}
			},
			{
				"matchesJsonPath": "$.awaitingSignals[?(@.name == 'investigation_completed' && @.label == 'Investigation completed')]"
			},
			{
				"matchesJsonPath": "$.awaitingSignals[?(@.name == 'process_cancelled')]"
			}
		]
	},
	"newScenarioState": "investigation_process-service---api-support-management-put-process-waiting",
	"requiredScenarioState": "review_process-service---api-support-management-put-process-waiting",
	"response": {
		"headers": {
			"Content-Type": "application/json",
			"Content-Encoding": "identity"
		},
		"body": "{}",
		"status": 200
	},
	"scenarioName": "action-errand-no-decision"
}
