{
	"name": "registration_check-permit-worker---api-support-management-put-process-failed",
	"request": {
		"method": "PUT",
		"urlPathPattern": "/api-support-management/2281/ALKT/errands/2c84f70a-6e95-4b31-8d6f-1a7b3c9e50d4/processes/[^/]+",
		"headers": {
			"X-Sent-By": {
				"equalTo": "pw-alkt; type=processEngine"
			}
		},
		"bodyPatterns": [
			{
				"matchesJsonPath": {
					"expression": "$.processStatus",
					"equalTo": "FAILED"
				}
			},
			{
				"matchesJsonPath": {
					"expression": "$.activities[0].errorCode",
					"equalTo": "INCIDENT"
				}
			},
			{
				"matchesJsonPath": {
					"expression": "$.activities[0].message",
					"contains": "is of type 'LowAlcoholBeerServingPermit', the process handles only type 'TobaccoSalesPermit'"
				}
			}
		]
	},
	"response": {
		"headers": {
			"Content-Type": "application/json"
		},
		"body": "{}",
		"status": 200
	}
}
