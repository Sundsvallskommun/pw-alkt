{
	"name": "registration_create-change-draft-worker---api-support-management-put-process-failed",
	"request": {
		"method": "PUT",
		"urlPathPattern": "/api-support-management/2281/ALKT/errands/9e6b0c45-1f72-4a83-b5d9-8c2e4f7a10b3/processes/[^/]+",
		"headers": {
			"X-Sent-By": {
				"equalTo": "pw-alkt; type=processEngine"
			}
		},
		"bodyPatterns": [
			{
				"matchesJsonPath": {
					"expression": "$.processStatus",
					"equalTo": "FAILED"
				}
			},
			{
				"matchesJsonPath": {
					"expression": "$.activities[0].errorCode",
					"equalTo": "INCIDENT"
				}
			},
			{
				"matchesJsonPath": {
					"expression": "$.activities[0].message",
					"contains": "is of type 'LowAlcoholBeerServingPermit', the process handles only type 'TobaccoSalesPermit'"
				}
			}
		]
	},
	"response": {
		"headers": {
			"Content-Type": "application/json"
		},
		"body": "{}",
		"status": 200
	}
}
